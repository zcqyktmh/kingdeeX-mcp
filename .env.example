# Copy to .env and configure locally. Never publish credentials or backup XML.
SQLSERVER_HOST=sqlserver.example.invalid
SQLSERVER_PORT=1433
SQLSERVER_INSTANCE=
SQLSERVER_DATABASE=YOUR_TEST_DATABASE
SQLSERVER_USER=YOUR_READ_ONLY_LOGIN
SQLSERVER_PASSWORD=CHANGE_ME_LOCALLY
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=false
SQLSERVER_CONNECTION_TIMEOUT_MS=15000
SQLSERVER_QUERY_TIMEOUT_MS=30000

# Must match SQLSERVER_DATABASE. Use an isolated test copy only.
KINGDEEX_ALLOWED_DATABASE=YOUR_TEST_DATABASE
# Actual extension metadata GUID, inheriting BD_Department; not BD_Department itself.
KINGDEEX_DEPARTMENT_FORM_ID=YOUR_EXTENSION_FORM_GUID
# Preview/read works with writes disabled.
KINGDEEX_ENABLE_WRITES=false

# Optional reference defaults. Fill actual GUIDs from your local metadata.
KINGDEEX_CUSTOMER_OBJECT_ID=
KINGDEEX_ORG_OBJECT_ID=
KINGDEEX_USER_OBJECT_ID=
KINGDEEX_UNIT_OBJECT_ID=

# Only used by administrative provisioning/repair scripts, never MCP arguments.
KINGDEEX_ADMIN_USER=sa
KINGDEEX_ADMIN_PASSWORD=
# Initial provision generates and saves a random writer password when blank.
SQLSERVER_KINGDEEX_WRITE_PASSWORD=

# Optional read-only metadata discovery. Configure both before using inspect_form_metadata.
KINGDEEX_INSPECT_FORM_CODE=
KINGDEEX_INSPECT_TABLE_PATTERN=
# Optional legacy repair: explicit existing field key, e.g. F_KINGDIEX_SAMPLE.
KINGDEEX_REPAIR_FIELD_KEY=
